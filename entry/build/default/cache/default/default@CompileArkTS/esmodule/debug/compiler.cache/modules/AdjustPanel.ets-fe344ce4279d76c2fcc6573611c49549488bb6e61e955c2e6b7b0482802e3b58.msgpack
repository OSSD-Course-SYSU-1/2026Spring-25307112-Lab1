import { AdjustParams, DEFAULT_ADJUST_PARAMS, PARAM_SLIDERS, ParamSliderConfig } from '../constants/CommonConstants';

/**
 * Parameter adjustment panel component
 * Provides sliders for adjusting image parameters like brightness, contrast, saturation, etc.
 */
@Component
export struct AdjustPanel {
  // Use @Link for two-way data binding to ensure slider updates on reset
  @Link brightnessValue: number;
  @Link contrastValue: number;
  @Link saturationValue: number;
  @Link hueValue: number;
  @Link warmthValue: number;
  @Link exposureValue: number;
  @Link gammaValue: number;
  
  // Callback for reset
  onReset?: () => void;
  
  build() {
    Column() {
      // Header with title and reset button - ç¾åŒ–çš„æ ‡é¢˜æ 
      Row() {
        Row() {
          Text('âš™ï¸ ')
            .fontSize(20)
          Text("å‚æ•°è°ƒæ•´")
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#2d3748')
        }
        
        Blank()
        
        // é‡ç½®æŒ‰é’® - æ¸å˜èƒŒæ™¯
        Button() {
          Row() {
            Text('â†º')
              .fontSize(16)
              .fontColor('#ffffff')
            Text('é‡ç½®')
              .fontSize(13)
              .fontColor('#ffffff')
              .fontWeight(FontWeight.Medium)
              .margin({ left: 4 })
          }
        }
        .linearGradient({
          angle: 90,
          colors: [
            ['#667eea', 0.0],
            ['#764ba2', 1.0]
          ]
        })
        .borderRadius(18)
        .height(36)
        .padding({ left: 16, right: 16 })
        .shadow({
          radius: 8,
          color: 'rgba(102, 126, 234, 0.3)',
          offsetX: 0,
          offsetY: 3
        })
        .onClick(() => {
          if (this.onReset) {
            this.onReset();
          }
        })
      }
      .width('100%')
      .margin({ bottom: 20 })
      
      // Scrollable slider list
      Scroll() {
        Column() {
          // Brightness - äº®åº¦
          this.SliderItem(
            'ğŸ’¡',
            'äº®åº¦',
            this.brightnessValue,
            0,
            200,
            (newValue: number) => {
              this.brightnessValue = Math.round(newValue);
            }
          )
          
          // Contrast - å¯¹æ¯”åº¦
          this.SliderItem(
            'ğŸ”²',
            'å¯¹æ¯”åº¦',
            this.contrastValue,
            0,
            200,
            (newValue: number) => {
              this.contrastValue = Math.round(newValue);
            }
          )
          
          // Saturation - é¥±å’Œåº¦
          this.SliderItem(
            'ğŸ¨',
            'é¥±å’Œåº¦',
            this.saturationValue,
            0,
            200,
            (newValue: number) => {
              this.saturationValue = Math.round(newValue);
            }
          )
          
          // Hue - è‰²ç›¸
          this.SliderItem(
            'ğŸŒˆ',
            'è‰²ç›¸',
            this.hueValue,
            0,
            360,
            (newValue: number) => {
              this.hueValue = Math.round(newValue);
            },
            'Â°'
          )
          
          // Warmth - è‰²æ¸©
          this.SliderItem(
            'ğŸŒ¡ï¸',
            'è‰²æ¸©',
            this.warmthValue,
            0,
            200,
            (newValue: number) => {
              this.warmthValue = Math.round(newValue);
            }
          )
          
          // Exposure - æ›å…‰
          this.SliderItem(
            'â˜€ï¸',
            'æ›å…‰',
            this.exposureValue,
            0,
            200,
            (newValue: number) => {
              this.exposureValue = Math.round(newValue);
            }
          )
          
          // Gamma - ä¼½é©¬
          this.SliderItem(
            'ğŸ“Š',
            'ä¼½é©¬',
            this.gammaValue,
            0,
            200,
            (newValue: number) => {
              this.gammaValue = Math.round(newValue);
            }
          )
        }
        .width('100%')
      }
      .width('100%')
      .layoutWeight(1)
      .scrollBar(BarState.Off)
      .edgeEffect(EdgeEffect.Spring)
    }
    .width('100%')
    .height('100%')
    .padding(24)
    .backgroundColor('#ffffff')
    .borderRadius(24)
    .shadow({
      radius: 20,
      color: 'rgba(0, 0, 0, 0.08)',
      offsetX: 0,
      offsetY: 8
    })
  }
  
  // ç¾åŒ–çš„æ»‘å—é¡¹ç»„ä»¶
  @Builder
  SliderItem(
    icon: string,
    label: string,
    value: number,
    min: number,
    max: number,
    onChange: (value: number) => void,
    unit: string = ''
  ) {
    Column() {
      // æ ‡ç­¾å’Œæ•°å€¼æ˜¾ç¤º
      Row() {
        // å›¾æ ‡å’Œæ ‡ç­¾
        Row() {
          Text(icon)
            .fontSize(18)
          Text(label)
            .fontSize(14)
            .fontColor('#4a5568')
            .fontWeight(FontWeight.Medium)
            .margin({ left: 6 })
        }
        
        Blank()
        
        // æ•°å€¼æ˜¾ç¤º - å¸¦èƒŒæ™¯å¡ç‰‡
        Row() {
          Text(`${Math.round(value)}${unit}`)
            .fontSize(14)
            .fontColor('#667eea')
            .fontWeight(FontWeight.Bold)
        }
        .padding({ left: 12, right: 12, top: 4, bottom: 4 })
        .backgroundColor('rgba(102, 126, 234, 0.1)')
        .borderRadius(10)
      }
      .width('100%')
      .margin({ bottom: 10 })
      
      // æ»‘å—è½¨é“ - è‡ªå®šä¹‰æ ·å¼
      Stack() {
        // èƒŒæ™¯è½¨é“
        Row()
          .width('100%')
          .height(6)
          .backgroundColor('rgba(102, 126, 234, 0.15)')
          .borderRadius(3)
        
        // è¿›åº¦å¡«å……
        Row()
          .width(`${((value - min) / (max - min)) * 100}%`)
          .height(6)
          .linearGradient({
            angle: 90,
            colors: [
              ['#667eea', 0.0],
              ['#764ba2', 1.0]
            ]
          })
          .borderRadius(3)
      }
      .width('100%')
      .height(6)
      
      // å®é™…æ»‘å—ï¼ˆé€æ˜ï¼Œç”¨äºäº¤äº’ï¼‰
      Slider({
        value: value,
        min: min,
        max: max,
        step: 1,
        style: SliderStyle.OutSet
      })
        .blockColor('transparent')
        .trackColor('transparent')
        .selectedColor('transparent')
        .showSteps(false)
        .showTips(false)
        .width('100%')
        .height(20)
        .onChange(onChange)
    }
    .width('100%')
    .padding({ top: 12, bottom: 12 })
  }
}
