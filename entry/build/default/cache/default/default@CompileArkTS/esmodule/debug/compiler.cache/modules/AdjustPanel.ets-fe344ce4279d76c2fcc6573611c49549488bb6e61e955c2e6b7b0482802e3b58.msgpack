            .margin({ left: 6 })
        }
        
        Blank()
        
        // æ•°å€¼æ˜¾ç¤º - å¸¦èƒŒæ™¯å¡ç‰‡
        Row() {
          Text(`${Math.round(value)}${unit}`)
            .fontSize(14 * DeviceHelper.getFontScaleFactor(this.deviceType))
            .fontColor('#667eea')
            .fontWeight(FontWeight.Bold)
        }
        .padding({ left: 12, right: 12, top: 4, bottom: 4 })
        .backgroundColor('rgba(102, 126, 234, 0.1)')
        .borderRadius(10)
      }
      .width('100%')
      .margin({ bottom: 10 })
      
      // æ»‘å—è½¨é“ - è‡ªå®šä¹‰æ ·å¼
      Stack() {
        // èƒŒæ™¯è½¨é“
        Row()
          .width('100%')
          .height(6)
          .backgroundColor('rgba(102, 126, 234, 0.15)')
          .borderRadius(3)
        
        // è¿›åº¦å¡«å……
        Row()
          .width(`${((value - min) / (max - min)) * 100}%`)
          .height(6)
          .linearGradient({
            angle: 90,
            colors: [
              ['#667eea', 0.0],
              ['#764ba2', 1.0]
            ]
          })
          .borderRadius(3)
      }
      .width('100%')
      .height(6)
      
      // å®é™…æ»‘å—ï¼ˆé€æ˜ï¼Œç”¨äºäº¤äº’ï¼‰
      Slider({
        value: value,
        min: min,
        max: max,
        step: 1,
        style: SliderStyle.OutSet
      })
        .blockColor('transparent')
        .trackColor('transparent')
        .selectedColor('transparent')
        .showSteps(false)
        .showTips(false)
        .width('100%')
        .height(20)
        .onChange(onChange)
    }
    .width('100%')
    .padding({ 
      top: 12 * DeviceHelper.getSpacingScaleFactor(this.deviceType), 
      bottom: 12 * DeviceHelper.getSpacingScaleFactor(this.deviceType) 
    })
  }
}
