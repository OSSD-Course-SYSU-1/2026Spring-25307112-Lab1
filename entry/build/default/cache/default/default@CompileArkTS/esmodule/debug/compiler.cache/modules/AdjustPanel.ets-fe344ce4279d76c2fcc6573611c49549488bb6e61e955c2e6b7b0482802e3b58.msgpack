  // ç¾åŒ–çš„æ»‘å—é¡¹ç»„ä»¶
  @Builder
  SliderItem(
    icon: string,
    label: string,
    value: number,
    min: number,
    max: number,
    onChange: (value: number) => void,
    unit: string = ''
  ) {
    Column() {
      // æ ‡ç­¾å’Œæ•°å€¼æ˜¾ç¤º
      Row() {
        // å›¾æ ‡å’Œæ ‡ç­¾
        Row() {
          Text(icon)
            .fontSize(18 * DeviceHelper.getFontScaleFactor(this.deviceType))
          Text(label)
            .fontSize(14 * DeviceHelper.getFontScaleFactor(this.deviceType))
            .fontColor('#4a5568')
