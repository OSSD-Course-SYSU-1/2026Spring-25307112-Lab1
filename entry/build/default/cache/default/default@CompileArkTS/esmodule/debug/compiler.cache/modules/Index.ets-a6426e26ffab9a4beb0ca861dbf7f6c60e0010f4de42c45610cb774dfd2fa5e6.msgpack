            // å½“å‰æ»¤é•œæŒ‡ç¤º
            Text.borderRadius(12);
        }, Text);
        // å½“å‰æ»¤é•œæŒ‡ç¤º
        Text.pop();
        // æ ‡é¢˜æ 
