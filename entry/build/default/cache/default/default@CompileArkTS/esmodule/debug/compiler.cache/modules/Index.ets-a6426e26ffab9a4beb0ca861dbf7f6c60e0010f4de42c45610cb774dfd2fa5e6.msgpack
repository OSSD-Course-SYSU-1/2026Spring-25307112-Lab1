            Text.fontWeight(FontWeight.Medium);
            // å½“å‰æ»¤é•œæŒ‡ç¤º
            Text.padding({ left: 12, right: 12, top: 6, bottom: 6 });
            // å½“å‰æ»¤é•œæŒ‡ç¤º
