import { router, display } from '@kit.ArkUI';
import { DeviceHelper, DeviceType } from '../utils/DeviceHelper';

/**
 * Splash Page - ç²¾ç¾Žçš„å¯åŠ¨ç•Œé¢
 * å±•ç¤ºåº”ç”¨å“ç‰Œå½¢è±¡ï¼ŒåŒ…å«åŠ¨ç”»æ•ˆæžœå’ŒåŠ è½½æŒ‡ç¤ºå™¨
 * æ”¯æŒå¤šç«¯é€‚é…ï¼Œåœ¨ä¸åŒè®¾å¤‡ä¸Šè‡ªåŠ¨è°ƒæ•´å¸ƒå±€
 */
@Entry
@Component
struct SplashPage {
  // è®¾å¤‡ç±»åž‹å’Œå±å¹•å°ºå¯¸
  @State deviceType: DeviceType = DeviceType.PHONE;
  @State screenWidth: number = 360;
  @State screenHeight: number = 640;
  
  // Logoç¼©æ”¾åŠ¨ç”»çŠ¶æ€
  @State logoScale: number = 0.3;
  @State logoOpacity: number = 0;
  
  // æ ‡é¢˜æ¸å…¥åŠ¨ç”»çŠ¶æ€
  @State titleOpacity: number = 0;
  @State titleTranslateY: number = 30;
  
  // å‰¯æ ‡é¢˜æ¸å…¥åŠ¨ç”»çŠ¶æ€
  @State subtitleOpacity: number = 0;
  
  // è¿›åº¦æ¡åŠ¨ç”»çŠ¶æ€
  @State progressWidth: number = 0;
  @State progressOpacity: number = 0;
  
  // è£…é¥°åœ†åœˆåŠ¨ç”»çŠ¶æ€
  @State circle1Scale: number = 0;
  @State circle2Scale: number = 0;
  @State circle3Scale: number = 0;
  
  // èƒŒæ™¯æ¸å˜åŠ¨ç”»
  @State bgGradientOffset: number = 0;

  aboutToAppear(): void {
    // èŽ·å–å±å¹•å°ºå¯¸å¹¶è®¾ç½®è®¾å¤‡ç±»åž‹
    this.updateScreenInfo();
    
    // å¯åŠ¨åŠ¨ç”»åºåˆ—
    this.startAnimationSequence();
  }
  
  // æ›´æ–°å±å¹•ä¿¡æ¯
  private updateScreenInfo(): void {
    try {
      const displayInfo = display.getDefaultDisplaySync();
      this.screenWidth = px2vp(displayInfo.width);
      this.screenHeight = px2vp(displayInfo.height);
      this.deviceType = DeviceHelper.getDeviceType(this.screenWidth);
    } catch (error) {
      // ä½¿ç”¨é»˜è®¤å€¼
      this.deviceType = DeviceType.PHONE;
    }
  }

  // å¯åŠ¨åŠ¨ç”»åºåˆ—
  private startAnimationSequence(): void {
    // è£…é¥°åœ†åœˆåŠ¨ç”» (ç«‹å³å¼€å§‹)
    setTimeout(() => {
      this.animateCircles();
    }, 100);
    
    // LogoåŠ¨ç”» (200msåŽå¼€å§‹)
    setTimeout(() => {
      this.animateLogo();
    }, 200);
    
    // æ ‡é¢˜åŠ¨ç”» (800msåŽå¼€å§‹)
    setTimeout(() => {
      this.animateTitle();
    }, 800);
    
    // å‰¯æ ‡é¢˜åŠ¨ç”» (1200msåŽå¼€å§‹)
    setTimeout(() => {
      this.animateSubtitle();
    }, 1200);
    
    // è¿›åº¦æ¡åŠ¨ç”» (1500msåŽå¼€å§‹)
    setTimeout(() => {
      this.animateProgress();
    }, 1500);
    
    // è·³è½¬åˆ°ä¸»é¡µ (3000msåŽ)
    setTimeout(() => {
      this.navigateToMain();
    }, 3000);
  }

  // LogoåŠ¨ç”»
  private animateLogo(): void {
    animateTo({
      duration: 600,
      curve: Curve.FastOutSlowIn,
      onFinish: () => {
        // Logoå‘¼å¸åŠ¨ç”»
        this.startBreathingAnimation();
      }
    }, () => {
      this.logoScale = 1.0;
      this.logoOpacity = 1.0;
    });
  }

  // Logoå‘¼å¸åŠ¨ç”»
  private startBreathingAnimation(): void {
    const breathe = () => {
      animateTo({
        duration: 1500,
        curve: Curve.EaseInOut,
        iterations: -1
      }, () => {
        this.logoScale = 1.05;
      });
    };
    breathe();
  }

  // æ ‡é¢˜åŠ¨ç”»
  private animateTitle(): void {
    animateTo({
      duration: 500,
      curve: Curve.FastOutSlowIn
    }, () => {
      this.titleOpacity = 1.0;
      this.titleTranslateY = 0;
    });
  }

  // å‰¯æ ‡é¢˜åŠ¨ç”»
  private animateSubtitle(): void {
    animateTo({
      duration: 400,
      curve: Curve.FastOutSlowIn
    }, () => {
      this.subtitleOpacity = 1.0;
    });
  }

  // è¿›åº¦æ¡åŠ¨ç”»
  private animateProgress(): void {
    animateTo({
      duration: 300,
      curve: Curve.FastOutSlowIn
    }, () => {
      this.progressOpacity = 1.0;
    });
    
    setTimeout(() => {
      animateTo({
        duration: 1200,
        curve: Curve.Linear
      }, () => {
        this.progressWidth = 100;
      });
    }, 100);
  }

  // è£…é¥°åœ†åœˆåŠ¨ç”»
  private animateCircles(): void {
    animateTo({
      duration: 800,
      curve: Curve.FastOutSlowIn
    }, () => {
      this.circle1Scale = 1.0;
    });
    
    setTimeout(() => {
      animateTo({
        duration: 800,
        curve: Curve.FastOutSlowIn
      }, () => {
        this.circle2Scale = 1.0;
      });
    }, 150);
    
    setTimeout(() => {
      animateTo({
        duration: 800,
        curve: Curve.FastOutSlowIn
      }, () => {
        this.circle3Scale = 1.0;
      });
    }, 300);
  }

  // å¯¼èˆªåˆ°ä¸»é¡µ
  private navigateToMain(): void {
    router.replaceUrl({
      url: 'pages/Index'
    });
  }

  build() {
    Stack() {
      // èƒŒæ™¯æ¸å˜å±‚
      Column()
        .width('100%')
        .height('100%')
        .linearGradient({
          angle: 135,
          colors: [
            ['#667eea', 0.0],
            ['#764ba2', 0.5],
            ['#f093fb', 1.0]
          ]
        })
      
      // è£…é¥°åœ†åœˆå±‚
      Stack() {
        // åœ†åœˆ1 - å·¦ä¸Š
        Circle()
          .width(200)
          .height(200)
          .fill('rgba(255, 255, 255, 0.1)')
          .position({ x: -60, y: -60 })
          .scale({ x: this.circle1Scale, y: this.circle1Scale })
          .blur(20)
        
        // åœ†åœˆ2 - å³ä¸‹
        Circle()
          .width(280)
          .height(280)
          .fill('rgba(255, 255, 255, 0.08)')
          .position({ x: '70%', y: '60%' })
          .scale({ x: this.circle2Scale, y: this.circle2Scale })
          .blur(30)
        
        // åœ†åœˆ3 - ä¸­å³
        Circle()
          .width(150)
          .height(150)
          .fill('rgba(255, 255, 255, 0.12)')
          .position({ x: '60%', y: '10%' })
          .scale({ x: this.circle3Scale, y: this.circle3Scale })
          .blur(15)
      }
      .width('100%')
      .height('100%')
      
      // ä¸»å†…å®¹åŒºåŸŸ
      Column() {
        // LogoåŒºåŸŸ
        Column() {
          // Logoå›¾æ ‡ - ä½¿ç”¨æ»¤é•œå›¾æ ‡è®¾è®¡
          Stack() {
            // å¤–åœˆå…‰æ™•
            Circle()
              .width(DeviceHelper.getSplashLogoSize(this.deviceType))
              .height(DeviceHelper.getSplashLogoSize(this.deviceType))
              .fill('rgba(255, 255, 255, 0.15)')
              .blur(20)
            
            // ä¸»Logoå®¹å™¨
            Column() {
              // æ»¤é•œå›¾æ ‡ - ä¸‰å±‚å åŠ æ•ˆæžœ
              Stack() {
                // åº•å±‚ - æ¨¡æ‹Ÿæ»¤é•œå±‚
                Rect()
                  .width(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.5)
                  .height(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.5)
                  .radius(12)
                  .fill('rgba(255, 255, 255, 0.3)')
                  .rotate({ angle: -15 })
                
                // ä¸­å±‚
                Rect()
                  .width(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.5)
                  .height(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.5)
                  .radius(12)
                  .fill('rgba(255, 255, 255, 0.5)')
                  .rotate({ angle: 0 })
                
                // é¡¶å±‚ - ä¸»å›¾æ ‡
                Rect()
                  .width(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.5)
                  .height(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.5)
                  .radius(12)
                  .fill('rgba(255, 255, 255, 0.95)')
                  .rotate({ angle: 15 })
                
                // æ»¤é•œç¬¦å·
                Text('âœ¦')
                  .fontSize(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.28)
                  .fontColor('#764ba2')
                  .fontWeight(FontWeight.Bold)
              }
              .width(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.7)
              .height(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.7)
              .alignContent(Alignment.Center)
            }
            .width(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.85)
            .height(DeviceHelper.getSplashLogoSize(this.deviceType) * 0.85)
            .justifyContent(FlexAlign.Center)
            .alignItems(HorizontalAlign.Center)
          }
          .width(DeviceHelper.getSplashLogoSize(this.deviceType))
          .height(DeviceHelper.getSplashLogoSize(this.deviceType))
        }
        .scale({ x: this.logoScale, y: this.logoScale })
        .opacity(this.logoOpacity)
        .margin({ bottom: 30 })
        
        // åº”ç”¨æ ‡é¢˜
        Column() {
          Text('Image Filter')
            .fontSize(DeviceHelper.getSplashTitleSize(this.deviceType))
            .fontWeight(FontWeight.Bold)
            .fontColor('#ffffff')
            .textShadow({
              radius: 10,
              color: 'rgba(0, 0, 0, 0.3)',
              offsetX: 0,
              offsetY: 4
            })
          
          // å‰¯æ ‡é¢˜
          Text('ä¸“ä¸šå›¾åƒæ»¤é•œå¤„ç†å·¥å…·')
            .fontSize(DeviceHelper.getSplashTitleSize(this.deviceType) * 0.42)
            .fontColor('rgba(255, 255, 255, 0.85)')
            .margin({ top: 12 })
            .opacity(this.subtitleOpacity)
        }
        .opacity(this.titleOpacity)
        .translate({ y: this.titleTranslateY })
        .margin({ bottom: 60 })
        
        // åŠ è½½è¿›åº¦æ¡
        Column() {
          // è¿›åº¦æ¡èƒŒæ™¯
          Stack() {
            // èƒŒæ™¯è½¨é“
            Row()
              .width(200)
              .height(4)
              .backgroundColor('rgba(255, 255, 255, 0.2)')
              .borderRadius(2)
            
            // è¿›åº¦å¡«å……
            Row()
              .width(this.progressWidth * 2)
              .height(4)
              .linearGradient({
                angle: 90,
                colors: [
                  ['rgba(255, 255, 255, 0.8)', 0.0],
                  ['rgba(255, 255, 255, 1.0)', 1.0]
                ]
              })
              .borderRadius(2)
          }
          .width(200)
          .height(4)
          
          // åŠ è½½æ–‡å­—
          Text('æ­£åœ¨åŠ è½½...')
            .fontSize(12)
            .fontColor('rgba(255, 255, 255, 0.7)')
            .margin({ top: 12 })
        }
        .opacity(this.progressOpacity)
        .margin({ top: 20 })
        
        Blank()
        
        // åº•éƒ¨ç‰ˆæƒä¿¡æ¯
        Column() {
          Text('Powered by HarmonyOS')
            .fontSize(12)
            .fontColor('rgba(255, 255, 255, 0.5)')
        }
        .margin({ bottom: 30 })
      }
      .width('100%')
      .height('100%')
      .justifyContent(FlexAlign.Center)
    }
    .width('100%')
    .height('100%')
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
  }
}
